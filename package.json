{
  "name": "@ljwei-stak/dsh-folding-windows",
  "version": "0.3.1",
  "description": "DSH 侧边栏增强：功能区与工作区独立折叠，工作区项目支持置顶和取消置顶。",
  "type": "module",
  "license": "MIT",
  "author": "Alice-Marx",
  "main": "./entry.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./entry.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "entry.js",
    "lib",
    "src",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "preview": "node tools/preview.mjs",
    "prepack": "npm run build && npm run check"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alice-Marx/dsh-folding-Windows.git"
  },
  "homepage": "https://github.com/Alice-Marx/dsh-folding-Windows#readme",
  "bugs": {
    "url": "https://github.com/Alice-Marx/dsh-folding-Windows/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "plugin",
    "sidebar",
    "collapse",
    "windows"
  ],
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
